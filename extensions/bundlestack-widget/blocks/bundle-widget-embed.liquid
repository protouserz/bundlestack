{% comment %}
  App embed: quantity-break widget on product pages without placing a
  section block. Inactive until the merchant saves it in Theme settings.
  Deep-linked from the admin dashboard after install.
  Look: apply saved offer colors from /apps/bundlestack/offers.
{% endcomment %}

{% if request.page_type == 'product' and product %}
  <script src="{{ 'bundlestack-shared.js' | asset_url }}" defer></script>
  <script src="{{ 'bundlestack-promos.js' | asset_url }}" defer></script>

  <div
    id="bundlestack-widget-embed"
    class="bundlestack-widget bundlestack-widget--embed bundlestack-widget--pending bundlestack-widget--hidden"
    style="display:none!important;--bs-navy:{{ block.settings.text_color }};--bs-surface:{{ block.settings.background }};--bs-emerald:{{ block.settings.accent }};--bs-emerald-soft:{{ block.settings.selected_background }};--bs-emerald-border:{{ block.settings.accent }};"
    hidden
    data-product-id="gid://shopify/Product/{{ product.id }}"
    data-price-cents="{{ product.selected_or_first_available_variant.price }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-proxy-path="/apps/bundlestack/offers"
  >
    <div class="bundlestack-widget__header">
      <p class="bundlestack-widget__title">
        {{ block.settings.heading | default: 'Buy more, save more' }}
      </p>
    </div>
    <div
      class="bundlestack-widget__tiers"
      role="group"
      aria-label="{{ block.settings.heading | default: 'Buy more, save more' }}"
      aria-live="polite"
    ></div>
  </div>
  <script>
    (function () {
      var root = document.getElementById("bundlestack-widget-embed");
      if (!root) return;
      if (
        document.querySelector(
          ".bundlestack-widget:not(.bundlestack-widget--embed)",
        )
      ) {
        root.remove();
        return;
      }
      var host =
        document.querySelector("product-form") ||
        document.querySelector('form[action*="/cart/add"]');
      if (host && host.parentNode) host.parentNode.insertBefore(root, host);
    })();
  </script>
  <script>
    (function () {
      var root = document.getElementById("bundlestack-widget-embed");
      if (!root || !root.dataset.productId || !root.dataset.proxyPath) return;
      var url =
        root.dataset.proxyPath +
        "?product_id=" +
        encodeURIComponent(root.dataset.productId);
      var load =
        window.__bundlestackFetchJson ||
        function (path) {
          return fetch(path).then(function (res) {
            return res.json();
          });
        };
      load(url)
        .then(function (data) {
          var offer = (data.offers || [])[0];
          if (window.__bundlestackApplyLook) {
            window.__bundlestackApplyLook(root, offer && offer.widgetLook);
            return;
          }
          var look = offer && offer.widgetLook;
          if (!look) return;
          if (look.matchTheme === true || look.matchTheme === "true") return;
          var title = root.querySelector(".bundlestack-widget__title");
          if (title && look.heading) title.textContent = look.heading;
          if (look.textColor) root.style.setProperty("--bs-navy", look.textColor);
          if (look.background)
            root.style.setProperty("--bs-surface", look.background);
          if (look.accent) {
            root.style.setProperty("--bs-emerald", look.accent);
            root.style.setProperty("--bs-emerald-border", look.accent);
          }
          if (look.selectedBackground) {
            root.style.setProperty("--bs-emerald-soft", look.selectedBackground);
          }
        })
        .catch(function () {});
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "BundleStack qty breaks",
  "target": "body",
  "javascript": "bundlestack-widget.js",
  "stylesheet": "bundlestack-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy more, save more"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#059669"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "selected_background",
      "label": "Selected tier background",
      "default": "#ecfdf5"
    }
  ]
}
{% endschema %}
